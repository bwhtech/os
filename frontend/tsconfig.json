{
  "extends": "frappe-ui/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/components/email/email-editor/mount": ["./src/components/email/email-editor/api.ts"],
      "@/*": ["./src/*"],
      "#components/*": ["./node_modules/frappe-ui/src/components/*"],
      "#molecules/*": ["./node_modules/frappe-ui/src/molecules/*"],
      "#composables/*": ["./node_modules/frappe-ui/src/composables/*"],
      "#utils/*": ["./node_modules/frappe-ui/src/utils/*"]
    },
    "types": ["vite/client", "node"],
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "tailwind.config.js",
    "postcss.config.js"
  ],
  // The React Email editor typechecks on its own. See tsconfig.email.json.
  "exclude": ["src/components/email/email-editor/**"]
}
